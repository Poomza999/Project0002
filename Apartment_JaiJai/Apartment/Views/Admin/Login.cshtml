@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - DormFinder NPRU</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body style="background-color:#f0f2f5;">

    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <div class="text-center mb-3">
                        <i class="bi bi-shield-check fs-1" style="color:#1a3a6b"></i>
                    </div>
                    <h4 class="text-center mb-1">Admin Login</h4>
                    <p class="text-center text-muted small mb-3">สำหรับเจ้าหน้าที่มหาวิทยาลัยเท่านั้น</p>

                    <div class="text-center mb-3">
                        <span class="badge" style="background-color:#fff3e0; color:#7c3d00; border:1px solid #ffcc80;">
                            <i class="bi bi-lock"></i> ระบบจำกัดการเข้าถึง
                        </span>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Admin" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">อีเมลมหาวิทยาลัย</label>
                            <input type="email" name="email" class="form-control"
                                   placeholder="admin@npru.ac.th" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">รหัสผ่าน</label>
                            <div class="input-group">
                                <input type="password" name="password" class="form-control"
                                       placeholder="••••••••" id="adminPassword" required />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('adminPassword', 'eyeAdmin')">
                                    <i class="bi bi-eye" id="eyeAdmin"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn w-100 text-white"
                                style="background-color:#1a3a6b;">
                            <i class="bi bi-login"></i> เข้าสู่ระบบ Admin
                        </button>
                    </form>

                    <hr />
                    <p class="text-center small mb-0">
                        <a href="/" class="text-muted">← กลับหน้าหลัก</a>
                    </p>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('bi-eye');
        icon.classList.add('bi-eye-slash');
        } else {
        input.type = 'password';
        icon.classList.remove('bi-eye-slash');
        icon.classList.add('bi-eye');
        }
        }
    </script>

</body>
</html>