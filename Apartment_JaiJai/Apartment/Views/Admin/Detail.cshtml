@model Apartment.Models.Entities.Dormitory
@{
    ViewData["Title"] = "รายละเอียดหอพัก";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>รายละเอียดหอพัก - Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body style="background-color:#f0f2f5;">

    <nav class="navbar navbar-dark" style="background-color:#1a3a6b;">
        <div class="container">
            <span class="navbar-brand fw-bold">
                <i class="bi bi-shield-check"></i> Admin Panel — DormFinder NPRU
            </span>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white small">
                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")
                </span>
                <a href="/Account/Logout" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left"></i> กลับ Admin Panel
        </a>

        <div class="card shadow-sm mb-3">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
                    <div>
                        <h4 class="mb-1">@Model.DormName</h4>
                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (Model.Status == "PendingEdit")
                        {
                            <span class="badge bg-info text-dark">Pending Edit</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </div>

                    @if (Model.Status == "Pending" || Model.Status == "PendingEdit")
                    {
                        <div class="d-flex gap-2">
                            <form asp-action="Approve" asp-route-id="@Model.DormID" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-circle"></i> อนุมัติ
                                </button>
                            </form>
                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="bi bi-x-circle"></i> ปฏิเสธ
                            </button>
                        </div>
                    }
                </div>

                @if (Model.Images.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
                        {
                            <img src="@img.ImagePath" class="img-thumbnail"
                                 style="height:180px;object-fit:cover;" />
                        }
                    </div>
                }

                <table class="table table-bordered">
                    <tr>
                        <th style="width:150px" class="table-light">เจ้าของ</th>
                        <td>@Model.Owner.Name</td>
                    </tr>
                    <tr>
                        <th class="table-light">ที่อยู่</th>
                        <td>@Model.Address</td>
                    </tr>
                    <tr>
                        <th class="table-light">ราคา</th>
                        <td>@Model.Price.ToString("N0") บาท</td>
                    </tr>
                    <tr>
                        <th class="table-light">ประเภทห้อง</th>
                        <td>
                            @foreach (var rt in Model.DormRoomTypes.GroupBy(r => r.RoomType.Category))
                            {
                                <div class="mb-1">
                                    <span class="text-muted small">@rt.Key: </span>
                                    @foreach (var r in rt)
                                    {
                                        <span class="badge bg-primary me-1">@r.RoomType.Name</span>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th class="table-light">เบอร์ติดต่อ</th>
                        <td>@(Model.Phone ?? "-")</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.RejectReason))
                    {
                        <tr>
                            <th class="table-light text-danger">เหตุผลที่ปฏิเสธ</th>
                            <td class="text-danger">@Model.RejectReason</td>
                        </tr>
                    }
                </table>

                <h6 class="mt-3">สิ่งอำนวยความสะดวก</h6>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (Model.DormAmenities.Any())
                    {
                        @foreach (var a in Model.DormAmenities.GroupBy(a => a.Amenity.Category))
                        {
                            <div class="w-100 mb-1">
                                <span class="text-muted small">@a.Key: </span>
                                @foreach (var item in a)
                                {
                                    <span class="badge bg-secondary me-1">
                                        <i class="bi bi-check"></i> @item.Amenity.Name
                                    </span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">ไม่มีข้อมูล</span>
                    }
                </div>

            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h6>ประวัติการเปลี่ยนแปลง</h6>
                @if (Model.Histories.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var h in Model.Histories.OrderByDescending(h => h.ChangedAt))
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>
                                    <strong>@h.Action</strong>
                                    @if (!string.IsNullOrEmpty(h.Note))
                                    {
                                        <span class="text-muted"> — @h.Note</span>
                                    }
                                </span>
                                <span class="text-muted small">
                                    @h.ChangedAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">ไม่มีประวัติ</p>
                }
            </div>
        </div>

    </div>

    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Reject" asp-route-id="@Model.DormID" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">ปฏิเสธหอพัก</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">เหตุผลที่ปฏิเสธ <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3"
                                  placeholder="กรอกเหตุผล..." required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle"></i> ยืนยันปฏิเสธ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>