@model Apartment.Models.Entities.Dormitory
@{
    ViewData["Title"] = Model.DormName;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> กลับหน้าหลัก
    </a>
</div>

@* รูปภาพ *@
@if (Model.Images.Any())
{
    <div class="d-flex flex-wrap gap-2 mb-4">
        @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
        {
            <img src="@img.ImagePath" class="img-fluid rounded"
                 style="height:250px;object-fit:cover;" />
        }
    </div>
}

<div class="row">
    <div class="col-md-8">

        @* ชื่อและ Badge *@
        <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <h3 class="mb-0 fw-bold">@Model.DormName</h3>
            <span class="badge bg-success">
                <i class="bi bi-patch-check-fill"></i> ได้รับการรับรองจากมหาวิทยาลัยราชภัฏนครปฐม
            </span>
        </div>

        @* ข้อมูลหลัก *@
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <th style="width:130px" class="text-muted">
                            <i class="bi bi-geo-alt"></i> ที่อยู่
                        </th>
                        <td>@Model.Address</td>
                    </tr>
                    <tr>
                        <th class="text-muted">
                            <i class="bi bi-cash"></i> ราคา
                        </th>
                        <td>
                            <strong class="text-primary fs-5">
                                @Model.Price.ToString("N0")
                            </strong> บาท/เดือน
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted">
                            <i class="bi bi-phone"></i> ติดต่อ
                        </th>
                        <td>@(Model.Phone ?? "-")</td>
                    </tr>
                </table>
            </div>
        </div>

        @* ประเภทห้อง *@
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">
                <i class="bi bi-door-open"></i> ประเภทห้อง
            </div>
            <div class="card-body">
                @foreach (var group in Model.DormRoomTypes.GroupBy(r => r.RoomType.Category))
                {
                    <div class="mb-2">
                        <span class="text-muted small">@group.Key: </span>
                        @foreach (var r in group)
                        {
                            <span class="badge bg-primary me-1">@r.RoomType.Name</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* สิ่งอำนวยความสะดวก *@
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">
                <i class="bi bi-stars"></i> สิ่งอำนวยความสะดวก
            </div>
            <div class="card-body">
                @if (Model.DormAmenities.Any())
                {
                    @foreach (var group in Model.DormAmenities.GroupBy(a => a.Amenity.Category))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">@group.Key: </span>
                            @foreach (var a in group)
                            {
                                <span class="badge bg-secondary me-1">
                                    <i class="bi bi-check"></i> @a.Amenity.Name
                                </span>
                            }
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted">ไม่มีข้อมูล</span>
                }
            </div>
        </div>

    </div>

    <div class="col-md-4">
        <div class="card shadow-sm sticky-top" style="top:20px">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-primary mb-1">
                    @Model.Price.ToString("N0") บาท
                </div>
                <div class="text-muted small mb-3">ต่อเดือน</div>
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <a href="tel:@Model.Phone" class="btn btn-success w-100 mb-2">
                        <i class="bi bi-telephone-fill"></i> โทร @Model.Phone
                    </a>
                }
                <div class="alert alert-success small mb-0">
                    <i class="bi bi-patch-check-fill"></i>
                    ผ่านการรับรองจากมหาวิทยาลัยราชภัฏนครปฐม
                </div>
            </div>
        </div>
    </div>
</div>