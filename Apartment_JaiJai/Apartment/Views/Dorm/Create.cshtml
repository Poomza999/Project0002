@model Apartment.Models.ViewModels.DormFormViewModel
@{
    ViewData["Title"] = "เพิ่มหอพัก";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> กลับ
    </a>
    <h4 class="mb-0">เพิ่มหอพักใหม่</h4>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> หลังส่งข้อมูล Admin จะตรวจสอบและอนุมัติก่อนแสดงบนเว็บไซต์
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    @* หมวดข้อมูลทั่วไป *@
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">
            <i class="bi bi-info-circle"></i> ข้อมูลทั่วไป
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DormName" class="form-label">ชื่อหอพัก *</label>
                    <input asp-for="DormName" class="form-control" placeholder="เช่น หอพักสุขสวัสดิ์" />
                    <span asp-validation-for="DormName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Price" class="form-label">ราคา (บาท/เดือน) *</label>
                    <input asp-for="Price" class="form-control" type="number" placeholder="3500" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Phone" class="form-label">เบอร์ติดต่อ</label>
                    <input asp-for="Phone" class="form-control" placeholder="08X-XXX-XXXX" />
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label">ที่อยู่ *</label>
                    <input asp-for="Address" class="form-control"
                           placeholder="บ้านเลขที่ ถนน ตำบล อำเภอ จังหวัด" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    @* หมวดประเภทห้อง *@
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">
            <i class="bi bi-door-open"></i> ประเภทห้อง
        </div>
        <div class="card-body">
            @foreach (var group in Model.RoomTypes)
            {
                <div class="mb-3">
                    <div class="text-muted small fw-bold mb-2">@group.Key</div>
                    <div class="row g-2">
                        @foreach (var item in group.Value)
                        {
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedRoomTypeIDs" value="@item.Value"
                                           id="rt_@item.Value" />
                                    <label class="form-check-label" for="rt_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* หมวดสิ่งอำนวยความสะดวก *@
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">
            <i class="bi bi-stars"></i> สิ่งอำนวยความสะดวก
        </div>
        <div class="card-body">
            @foreach (var group in Model.AllAmenities)
            {
                <div class="mb-3">
                    <div class="text-muted small fw-bold mb-2">@group.Key</div>
                    <div class="row g-2">
                        @foreach (var item in group.Value)
                        {
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedAmenityIDs" value="@item.Value"
                                           id="am_@item.Value" />
                                    <label class="form-check-label" for="am_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* หมวดรูปภาพ *@
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">
            <i class="bi bi-images"></i> รูปภาพหอพัก
        </div>
        <div class="card-body">
            <input type="file" name="ImageFiles" class="form-control"
                   accept="image/*" multiple onchange="previewImages(this)" />
            <div class="small text-muted mt-1">สามารถเลือกได้หลายรูปพร้อมกัน</div>
            <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-3"></div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary px-4">
        <i class="bi bi-send"></i> ส่งข้อมูลรออนุมัติ
    </button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImages(input) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';
            if (input.files && input.files.length > 0) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = e => {
                        preview.innerHTML += `<div>
                            <img src="${e.target.result}" class="img-thumbnail"
                                style="width:120px;height:100px;object-fit:cover;" />
                        </div>`;
                    };
                    reader.readAsDataURL(file);
                });
            }
        }
    </script>
}