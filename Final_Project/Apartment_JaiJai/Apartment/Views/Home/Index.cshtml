@model IEnumerable<Apartment.Models.Entities.Dormitory>
@{
    ViewData["Title"] = "หน้าหลัก";
}

<div class="text-center py-4">
    <h1 class="fw-bold mb-2">หอพักสำหรับนักศึกษาราชภัฏนครปฐม</h1>
    <p class="text-muted mb-4">ค้นหาหอพักที่ผ่านการรับรองจากมหาวิทยาลัย</p>

    <form method="get" asp-action="Index">
        <div class="row justify-content-center g-2 mb-2">
            <div class="col-md-4">
                <input type="text" name="keyword" value="@ViewBag.Keyword"
                       class="form-control" placeholder="ค้นหาชื่อหอพัก หรือที่อยู่..." />
            </div>
            <div class="col-md-3">
                <select name="roomTypeID" class="form-select">
                    <option value="">ประเภทห้องทั้งหมด</option>
                    @foreach (var rt in ViewBag.RoomTypes)
                    {
                        <option value="@rt.RoomTypeID"
                                selected="@(ViewBag.RoomTypeID == rt.RoomTypeID ? "selected" : null)">
                            @rt.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> ค้นหา
                </button>
            </div>
            @if (ViewBag.IsSearching == true)
            {
                <div class="col-md-1">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x"></i> ล้าง
                    </a>
                </div>
            }
        </div>
    </form>
</div>

@* แสดงผลการค้นหา *@
<div class="d-flex justify-content-between align-items-center mb-3">
    @if (ViewBag.IsSearching == true)
    {
        <span class="text-muted">
            ผลการค้นหา <strong>@Model.Count()</strong> แห่ง
        </span>
    }
    else
    {
        <span class="text-muted">
            หอพักที่แนะนำ <strong>@Model.Count()</strong> แห่ง
        </span>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-building-slash fs-1"></i>
        <p class="mt-2">ไม่พบหอพักที่ตรงกับการค้นหา</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var dorm in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (dorm.Images.Any())
                    {
                        <img src="@dorm.Images.OrderBy(i => i.SortOrder).First().ImagePath"
                             class="card-img-top"
                             style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary bg-opacity-10"
                             style="height:200px;">
                            <i class="bi bi-image text-muted fs-1"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@dorm.DormName</h5>
                        <span class="badge bg-success mb-2">
                            <i class="bi bi-patch-check-fill"></i> รับรองจากมหาวิทยาลัย
                        </span>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt"></i> @dorm.Address
                        </p>
                        <p class="mb-1">
                            <strong class="text-primary">@dorm.Price.ToString("N0")</strong> บาท/เดือน
                        </p>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var rt in dorm.DormRoomTypes.Select(r => r.RoomType))
                            {
                                <span class="badge bg-secondary">@rt.Name</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Detail" asp-route-id="@dorm.DormID"
                           class="btn btn-outline-primary btn-sm w-100">
                            ดูรายละเอียด <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}