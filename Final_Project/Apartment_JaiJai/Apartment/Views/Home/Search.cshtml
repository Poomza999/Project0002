@model IEnumerable<Apartment.Models.Entities.Dormitory>
@{ ViewData["Title"] = "ผลการค้นหา"; }

<div class="row mb-4">
    <div class="col-12">
        <form asp-controller="Home" asp-action="Search" method="get">
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="keyword" value="@ViewBag.Keyword"
                           class="form-control" placeholder="ค้นหาชื่อหอพัก หรือที่อยู่..." />
                </div>
                <div class="col-md-3">
                    <select name="roomTypeID" class="form-select">
                        <option value="">ประเภทห้องทั้งหมด</option>
                        <option value="1" selected="@(ViewBag.RoomTypeID == 1 ? "selected" : null)">ห้องเดี่ยว</option>
                        <option value="2" selected="@(ViewBag.RoomTypeID == 2 ? "selected" : null)">ห้องคู่</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> ค้นหา
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">พบหอพัก <strong>@Model.Count()</strong> แห่ง</p>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-building-slash fs-1"></i>
        <p class="mt-2">ไม่พบหอพักที่ตรงกับการค้นหา</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var dorm in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(dorm.ImagePath))
                    {
                        <img src="@dorm.ImagePath" class="card-img-top"
                             style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height:200px;">
                            <i class="bi bi-image text-muted fs-1"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@dorm.DormName</h5>
                        <span class="badge bg-success mb-2">
                            <i class="bi bi-patch-check-fill"></i> รับรองจากมหาวิทยาลัย
                        </span>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt"></i> @dorm.Address
                        </p>
                        <p class="mb-1">
                            <strong class="text-primary">@dorm.Price.ToString("N0")</strong> บาท/เดือน
                        </p>
                        @foreach (var rt in dorm.DormRoomTypes.Select(r => r.RoomType))
                        {
                            <span class="badge bg-secondary">@rt.Name</span>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="Detail" asp-route-id="@dorm.DormID"
                           class="btn btn-outline-primary btn-sm w-100">
                            ดูรายละเอียด <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}