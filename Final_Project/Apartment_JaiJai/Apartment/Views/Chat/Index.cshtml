@{
    ViewData["Title"] = "DormBot";
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="text-center mb-4">
            <h4 class="fw-bold"><i class="bi bi-robot"></i> DormBot</h4>
            <p class="text-muted small">ถามเรื่องหอพักได้เลยครับ เช่น "หอราคาไม่เกิน 3000" หรือ "หอที่มีแอร์มีไหม"</p>
        </div>

        @* กล่องแชท *@
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div id="chatBox"
                     style="height:420px;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;">

                    @* ข้อความต้อนรับ *@
                    <div class="d-flex gap-2 align-items-start">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:32px;height:32px;">
                            <i class="bi bi-robot text-white" style="font-size:14px;"></i>
                        </div>
                        <div class="p-2 px-3 rounded-3 border" style="max-width:80%;">
                            สวัสดีครับ! ผม DormBot ช่วยค้นหาหอพักสำหรับนักศึกษาราชภัฏนครปฐมครับ 😊
                            <br />ลองถามได้เลย เช่น
                            <ul class="mb-0 mt-1 small">
                                <li>"หอราคาไม่เกิน 3,000 บาทมีไหม"</li>
                                <li>"หอที่มีแอร์และ WiFi"</li>
                                <li>"หอห้องเดี่ยวมีที่ไหนบ้าง"</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

            @* ช่องพิมพ์ *@
            <div class="card-footer p-2">
                <div class="input-group">
                    <input type="text" id="chatInput" class="form-control"
                           placeholder="พิมพ์คำถามที่นี่..."
                           onkeydown="if(event.key==='Enter') sendMessage()" />
                    <button class="btn btn-primary" onclick="sendMessage()" id="sendBtn">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
                <div class="text-muted" style="font-size:11px;margin-top:4px;padding-left:4px;">
                    <i class="bi bi-info-circle"></i> Bot ตอบได้เฉพาะเรื่องหอพักเท่านั้น
                </div>
            </div>
        </div>

    </div>
</div>

@* Modal แจ้งเตือนยังไม่มี API Key *@
<div class="modal fade" id="noApiModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title text-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i> ยังไม่พร้อมใช้งาน
                </h6>
            </div>
            <div class="modal-body">
                <p class="small mb-0">ระบบ Chatbot ยังไม่ได้ตั้งค่า API Key กรุณาติดต่อผู้ดูแลระบบครับ</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm w-100">
                    กลับหน้าหลัก
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const hasApiKey = @Json.Serialize(!string.IsNullOrEmpty(ViewBag.HasApiKey as string ?? "") ? "true" : "false");

        // ถ้าไม่มี API Key แสดง Modal
        if (hasApiKey === "false") {
            document.addEventListener('DOMContentLoaded', function() {
                // ไม่ Lock แค่แสดง Warning
                document.getElementById('chatInput').placeholder = "ระบบยังไม่พร้อมใช้งาน (ยังไม่มี API Key)";
            });
        }

        function addMessage(text, isUser) {
            const box = document.getElementById('chatBox');

            if (isUser) {
                box.innerHTML += `
                    <div class="d-flex gap-2 align-items-start justify-content-end">
                        <div class="p-2 px-3 rounded-3 bg-primary text-white" style="max-width:80%;">
                            ${text}
                        </div>
                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:32px;height:32px;">
                            <i class="bi bi-person-fill text-white" style="font-size:14px;"></i>
                        </div>
                    </div>`;
            } else {
                box.innerHTML += `
                    <div class="d-flex gap-2 align-items-start">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:32px;height:32px;">
                            <i class="bi bi-robot text-white" style="font-size:14px;"></i>
                        </div>
                        <div class="p-2 px-3 rounded-3 border" style="max-width:80%;white-space:pre-line;">
                            ${text}
                        </div>
                    </div>`;
            }

            box.scrollTop = box.scrollHeight;
        }

        function addTyping() {
            const box = document.getElementById('chatBox');
            box.innerHTML += `
                <div class="d-flex gap-2 align-items-start" id="typingIndicator">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:32px;height:32px;">
                        <i class="bi bi-robot text-white" style="font-size:14px;"></i>
                    </div>
                    <div class="p-2 px-3 rounded-3 border">
                        <div class="d-flex gap-1 align-items-center" style="height:20px;">
                            <div class="rounded-circle bg-secondary" style="width:8px;height:8px;animation:bounce 1s infinite;"></div>
                            <div class="rounded-circle bg-secondary" style="width:8px;height:8px;animation:bounce 1s infinite 0.2s;"></div>
                            <div class="rounded-circle bg-secondary" style="width:8px;height:8px;animation:bounce 1s infinite 0.4s;"></div>
                        </div>
                    </div>
                </div>`;
            box.scrollTop = box.scrollHeight;
        }

        async function sendMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;

            input.value = '';
            input.disabled = true;
            document.getElementById('sendBtn').disabled = true;

            addMessage(msg, true);
            addTyping();

            try {
                const res = await fetch('/Chat/Send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg })
                });

                const data = await res.json();
                document.getElementById('typingIndicator')?.remove();
                addMessage(data.reply, false);

            } catch {
                document.getElementById('typingIndicator')?.remove();
                addMessage('ขออภัยครับ เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง', false);
            }

            input.disabled = false;
            document.getElementById('sendBtn').disabled = false;
            input.focus();
        }
    </script>

    <style>
        @@keyframes bounce {
            0%, 80%, 100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-6px);
            }
        }
    </style>
}