@model IEnumerable<Apartment.Models.Entities.Dormitory>
@{
    ViewData["Title"] = "Admin Panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - DormFinder NPRU</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body style="background-color:#f0f2f5;">

    <nav class="navbar navbar-dark" style="background-color:#1a3a6b;">
        <div class="container">
            <span class="navbar-brand fw-bold">
                <i class="bi bi-shield-check"></i> Admin Panel — DormFinder NPRU
            </span>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white small">
                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")
                </span>
                <a href="/Account/Logout" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">รายการหอพักรอตรวจสอบ</h4>
        </div>

        <div class="d-flex gap-2 mb-3 flex-wrap">
            <a asp-action="Index" class="btn btn-sm @(ViewBag.CurrentFilter == null ? "btn-primary" : "btn-outline-primary")">
                ทั้งหมด
            </a>
            <a asp-action="Index" asp-route-filter="Pending"
               class="btn btn-sm @(ViewBag.CurrentFilter == "Pending" ? "btn-warning" : "btn-outline-warning")">
                Pending
            </a>
            <a asp-action="Index" asp-route-filter="PendingEdit"
               class="btn btn-sm @(ViewBag.CurrentFilter == "PendingEdit" ? "btn-info" : "btn-outline-info")">
                Pending Edit
            </a>
            <a asp-action="Index" asp-route-filter="Approved"
               class="btn btn-sm @(ViewBag.CurrentFilter == "Approved" ? "btn-success" : "btn-outline-success")">
                Approved
            </a>
            <a asp-action="Index" asp-route-filter="Rejected"
               class="btn btn-sm @(ViewBag.CurrentFilter == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                Rejected
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead style="background-color:#f8f9fa;">
                        <tr>
                            <th>ชื่อหอพัก</th>
                            <th>เจ้าของ</th>
                            <th>ประเภท</th>
                            <th>ราคา</th>
                            <th>สถานะ</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    ไม่มีรายการ
                                </td>
                            </tr>
                        }
                        @foreach (var dorm in Model)
                        {
                            <tr>
                                <td>@dorm.DormName</td>
                                <td>@dorm.Owner.Name</td>
                                <td>@string.Join(", ", dorm.DormRoomTypes.Select(r => r.RoomType.Name))</td>
                                <td>@dorm.Price.ToString("N0") บาท</td>
                                <td>
                                    @if (dorm.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (dorm.Status == "PendingEdit")
                                    {
                                        <span class="badge bg-info text-dark">Pending Edit</span>
                                    }
                                    else if (dorm.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (dorm.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@dorm.DormID"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> ดูรายละเอียด
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>